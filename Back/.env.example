# Copie este arquivo para Back/.env e coloque os dados do SEU PostgreSQL.
# O .env não vai para o GitHub (cada integrante tem a sua senha do banco).
# Sem o .env, o Back usa os valores abaixo.

DB_NAME=sistemaVendas
DB_USER=postgres
DB_PASSWORD=nova_senha
DB_HOST=localhost
DB_PORT=5432

# Porta do Back (o front espera a 3000)
PORT=3000
