# Copie este arquivo para .env.local para mudar o comportamento em desenvolvimento.

# false (padrão) = usa o Back de verdade (precisa estar rodando na porta 3000, com o PostgreSQL).
# true = modo de teste: usa o Back falso do navegador (src/mocks), com dados de exemplo, sem banco.
VITE_USE_MOCK=false

# Endereço da API. Em dev, /api é redirecionado pelo Vite para http://localhost:3000.
VITE_API_URL=/api
