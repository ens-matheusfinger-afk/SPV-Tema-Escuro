# Copie este arquivo para .env.local para mudar o comportamento em desenvolvimento.

# true (padrão) = usa o Back falso do navegador (src/mocks), com dados de exemplo.
# false = usa o Back de verdade (precisa estar rodando na porta 3000).
VITE_USE_MOCK=true

# Endereço da API. Em dev, /api é redirecionado pelo Vite para http://localhost:3000.
VITE_API_URL=/api
